    "name": "Umrechnen",
    "func": "const raw = parseFloat(msg.payload);\nconst final = Math.round(raw * 100.0) / 100.0;\nmsg.payload = final;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
