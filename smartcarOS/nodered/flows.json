    "group": "ed218ebe43fa6cc7",
    "page": "",
    "ui": "",
    "name": "Battery",
    "order": 2,
    "width": "0",
    "height": "0",
    "head": "",
    "format": "<style>\n    .bat-wrap {\n        display: flex;\n        align-items: center;\n        gap: 14px;\n        padding: 8px 4px;\n        user-select: none;\n    }\n\n    .bat-shell {\n        position: relative;\n        width: 90px;\n        height: 38px;\n        border: 3px solid #333;\n        border-radius: 4px;\n        background: #fafafa;\n    }\n\n    .bat-shell::after {\n        content: '';\n        position: absolute;\n        right: -8px;\n        top: 9px;\n        width: 6px;\n        height: 16px;\n        background: #333;\n        border-radius: 0 2px 2px 0;\n    }\n\n    .bat-fill {\n        height: 100%;\n        transition: width 0.4s ease, background-color 0.4s ease;\n    }\n\n    .bat-info {\n        display: flex;\n        flex-direction: column;\n        line-height: 1.1;\n    }\n\n    .bat-volt {\n        font-size: 1.6em;\n        font-weight: bold;\n    }\n</style>\n\n<!-- Vue.js Syntax (Dashboard 2.0): Daten liegen standardmäßig direkt im 'msg' Objekt -->\n<div class=\"bat-wrap\" v-if=\"msg?.payload\">\n    <div class=\"bat-shell\">\n        <!-- :style ist die Vue-Kurzform für dynamische Styles -->\n        <div class=\"bat-fill\" \n             :style=\"{ \n                 width: (msg.payload.percent || 100) + '%', \n                 backgroundColor: msg.payload.color || 'green' \n             }\">\n        </div>\n    </div>\n    <div class=\"bat-info\">\n        <!-- V-Bind für die Textfarbe und normale Textausgabe via {{ msg.payload... }} -->\n        <span class=\"bat-volt\" :style=\"{ color: msg.payload.color || 'green' }\">\n            {{ msg.payload.vcc }}\n        </span>\n    </div>\n</div>\n",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 520,
    "y": 100,
    "wires": [
      []
    ]
  },
  {
