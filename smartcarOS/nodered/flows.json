    "page": "6e56bbe891184d11",
    "ui": "",
    "name": "CSS for centering leds",
    "order": 0,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "/* 1. Force the individual column grids inside your group to center their content */\n.center-my-leds .v-row > .v-col {\n    display: flex !important;\n    justify-content: center !important;\n    align-items: center !important;\n    text-align: center !important;\n}\n\n/* 2. Target the physical LED component container and snap it to the middle */\n.center-my-leds .nrdb-ui-led {\n    display: flex !important;\n    justify-content: center !important;\n    margin: 0 auto !important; /* Forces layout tracking to align perfectly central */\n    width: auto !important; \n}\n\n/* 3. Deep target the actual inner SVG/CSS bulb canvas if Vuetify overrides exist */\n.center-my-leds .nrdb-ui-led-bulb, \n.center-my-leds .v-avatar {\n    margin-left: auto !important;\n    margin-right: auto !important;\n}\n",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "page:style",
    "className": "",
    "x": 140,
